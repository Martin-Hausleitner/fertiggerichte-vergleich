{
  "name": "good-choice-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the Good Choice ready-meal app (data tools + UI bridge)",
  "bin": { "good-choice-mcp": "./src/index.ts" },
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "tsx src/index.ts --http",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "gen-schema": "tsx scripts/gen-schema.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
