#!/usr/bin/env bash
# Sensecheck 15 point 5: git pre-push hook (install: ln -sf ../../scripts/git-pre-push .git/hooks/pre-push).
# Runs only the fast data checks (gaps_overlay applied, regress_top50, row floor, no health fields); build/Playwright stay in prepush_gate.sh.
# Only pushes of main are checked (gh-pages deploys are handled by the Connector UI agent's deploy.sh).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
check=0
while read -r lref lsha rref rsha; do case "$rref" in refs/heads/main) check=1;; esac; done
[ "$check" = 1 ] || exit 0
GATE_FAST=1 ./scripts/prepush_gate.sh
